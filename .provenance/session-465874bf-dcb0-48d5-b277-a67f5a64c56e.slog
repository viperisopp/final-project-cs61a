eceptor","version":"0.1.6"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":true,"id":"ms-python.python","version":"2026.10.0"},{"enabled":true,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":true,"id":"ms-python.vscode-python-envs","version":"1.42.0"},{"enabled":true,"id":"ritwickdey.LiveServer","version":"5.7.10"},{"enabled":false,"id":"samplavigne.p5-vscode","version":"1.2.16"}]},"hash":"cad0cd14468e62485a36d09d557891305ed63a975b2b747c2f8e429792a2fcad","kind":"ext.snapshot","prev_hash":"cd1b0dab9eb6fabcacbeb1d20b92b83c96c40cd40e1297f7bdf5165f1c4a3d14","seq":4787,"t":71950298,"wall":"2026-11-15T21:55:27.967Z"}
