{"data":{"extensions":[{"enabled":true,"id":"TypeScriptTeam.jsts-chat-features","version":"0.0.6"},{"enabled":false,"id":"vscode.bat","version":"10.0.0"},{"enabled":false,"id":"vscode.clojure","version":"10.0.0"},{"enabled":false,"id":"vscode.coffeescript","version":"10.0.0"},{"enabled":true,"id":"vscode.configuration-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.cpp","version":"10.0.0"},{"enabled":false,"id":"vscode.csharp","version":"10.0.0"},{"enabled":false,"id":"vscode.css","version":"10.0.0"},{"enabled":false,"id":"vscode.css-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.dart","version":"10.0.0"},{"enabled":true,"id":"vscode.debug-auto-launch","version":"10.0.0"},{"enabled":false,"id":"vscode.debug-server-ready","version":"10.0.0"},{"enabled":false,"id":"vscode.diff","version":"10.0.0"},{"enabled":false,"id":"vscode.docker","version":"10.0.0"},{"enabled":false,"id":"vscode.dotenv","version":"10.0.0"},{"enabled":true,"id":"vscode.emmet","version":"10.0.0"},{"enabled":true,"id":"vscode.extension-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.fsharp","version":"10.0.0"},{"enabled":true,"id":"vscode.git","version":"10.0.0"},{"enabled":true,"id":"vscode.git-base","version":"10.0.0"},{"enabled":true,"id":"vscode.github","version":"0.0.1"},{"enabled":true,"id":"vscode.github-authentication","version":"0.0.2"},{"enabled":false,"id":"vscode.go","version":"10.0.0"},{"enabled":false,"id":"vscode.groovy","version":"10.0.0"},{"enabled":false,"id":"vscode.grunt","version":"10.0.0"},{"enabled":false,"id":"vscode.gulp","version":"10.0.0"},{"enabled":false,"id":"vscode.handlebars","version":"10.0.0"},{"enabled":false,"id":"vscode.hlsl","version":"10.0.0"},{"enabled":false,"id":"vscode.html","version":"10.0.0"},{"enabled":false,"id":"vscode.html-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.ini","version":"10.0.0"},{"enabled":false,"id":"vscode.ipynb","version":"10.0.0"},{"enabled":false,"id":"vscode.jake","version":"10.0.0"},{"enabled":false,"id":"vscode.java","version":"10.0.0"},{"enabled":false,"id":"vscode.javascript","version":"10.0.0"},{"enabled":false,"id":"vscode.json","version":"10.0.0"},{"enabled":true,"id":"vscode.json-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.julia","version":"10.0.0"},{"enabled":false,"id":"vscode.latex","version":"10.0.0"},{"enabled":false,"id":"vscode.less","version":"10.0.0"},{"enabled":false,"id":"vscode.log","version":"10.0.0"},{"enabled":false,"id":"vscode.lua","version":"10.0.0"},{"enabled":false,"id":"vscode.make","version":"10.0.0"},{"enabled":false,"id":"vscode.markdown","version":"30.0.0"},{"enabled":true,"id":"vscode.markdown-language-features","version":"10.0.0"},{"enabled":true,"id":"vscode.markdown-math","version":"10.0.0"},{"enabled":true,"id":"vscode.merge-conflict","version":"10.0.0"},{"enabled":true,"id":"vscode.mermaid-markdown-features","version":"10.0.0"},{"enabled":false,"id":"vscode.microsoft-authentication","version":"0.0.1"},{"enabled":false,"id":"ms-vscode.js-debug","version":"1.140.0"},{"enabled":false,"id":"ms-vscode.js-debug-companion","version":"1.1.3"},{"enabled":false,"id":"ms-vscode.vscode-js-profile-table","version":"1.0.11"},{"enabled":false,"id":"vscode.builtin-notebook-renderers","version":"10.0.0"},{"enabled":true,"id":"vscode.npm","version":"10.0.0"},{"enabled":false,"id":"vscode.objective-c","version":"10.0.0"},{"enabled":false,"id":"vscode.perl","version":"10.0.0"},{"enabled":false,"id":"vscode.php","version":"10.0.0"},{"enabled":false,"id":"vscode.php-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.powershell","version":"10.0.0"},{"enabled":false,"id":"vscode.prompt","version":"10.0.0"},{"enabled":false,"id":"vscode.pug","version":"10.0.0"},{"enabled":false,"id":"vscode.python","version":"10.0.0"},{"enabled":false,"id":"vscode.r","version":"10.0.0"},{"enabled":false,"id":"vscode.razor","version":"10.0.0"},{"enabled":false,"id":"vscode.references-view","version":"10.0.0"},{"enabled":false,"id":"vscode.restructuredtext","version":"10.0.0"},{"enabled":false,"id":"vscode.ruby","version":"10.0.0"},{"enabled":false,"id":"vscode.rust","version":"10.0.0"},{"enabled":false,"id":"vscode.scss","version":"10.0.0"},{"enabled":false,"id":"vscode.search-result","version":"10.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"10.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"10.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"10.0.0"},{"enabled":false,"id":"vscode.sql","version":"10.0.0"},{"enabled":false,"id":"vscode.swift","version":"10.0.0"},{"enabled":true,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-modern-icons","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"10.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript","version":"10.0.0"},{"enabled":true,"id":"vscode.typescript-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.vb","version":"10.0.0"},{"enabled":false,"id":"vscode.xml","version":"10.0.0"},{"enabled":false,"id":"vscode.yaml","version":"10.0.0"},{"enabled":true,"id":"Anthropic.claude-code","version":"2.1.325"},{"enabled":true,"id":"berkeley-ai4ed.preceptor","version":"0.1.6"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":true,"id":"ms-python.python","version":"2026.10.0"},{"enabled":true,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":true,"id":"ms-python.vscode-python-envs","version":"1.42.0"},{"enabled":true,"id":"ritwickdey.LiveServer","version":"5.7.10"},{"enabled":false,"id":"samplavigne.p5-vscode","version":"1.2.16"}]},"hash":"5937dfce7d5113c766d1ad8f8cfe1747b84bec675e8f428ecb0a99760c9dde8f","kind":"ext.snapshot","prev_hash":"c6d99c9a34d0036eae22d6f33abaf073f5230014e2c3c54a34b05b018c625a06","seq":5331,"t":78550321,"wall":"2026-11-15T23:45:27.827Z"}
