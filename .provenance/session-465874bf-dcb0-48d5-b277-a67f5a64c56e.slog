{"data":{"diff_size":2110,"new_content":"//// The game's levels: where the anchor starts, and the red (\"evil\") paths the\n//// player must avoid. See game.gleam for the rules.\n////\n//// Coordinates are the canvas's: (0, 0) is the centre, x and y run from -500 to\n//// 500, and y grows downward, so the top edge is y = -500.\n\nimport shape.{type Path, type Point, Line, Path, Point}\n\npub type Level {\n  Level(\n    name: String,\n    // Where the anchor is when the level starts or restarts.\n    start: Point,\n    // The red paths, timed on the red clock (tenths of a second).\n    red: List(Path),\n    // True: the red paths start over from an empty canvas after they finish.\n    // False: they stay once drawn.\n    loop: Bool,\n  )\n}\n\n/// The code a level starts with, before the player has edited it.\npub const starter_code = \"fn draw(shape_slider: Int) -> List(Path) {\n  [Path(Line(anchor, Point(anchor.x, anchor.y - 250)), 0, 10, 4)]\n}\n\nfn move_anchor(anchor: Point) -> Point {\n  Point(anchor.x, anchor.y - 200)\n}\n\"\n\n/// Every level, in menu order.\n/// PLACEHOLDERS: two simple levels to exercise both kinds of red drawing. The\n/// real levels are still to be designed.\npub fn all() -> List(Level) {\n  [\n    Level(\n      name: \"Level 1\",\n      start: Point(0.0, 480.0),\n      red: [\n        red(0, -500, 0, 150, 0, 40),\n        red(0, -500, -350, 100, 5, 45),\n        red(0, -500, 350, 100, 5, 45),\n        red(0, -150, -200, 50, 20, 40),\n      ],\n      loop: False,\n    ),\n    Level(\n      name: \"Level 2\",\n      start: Point(0.0, 480.0),\n      red: [\n        red(-300, -500, -300, 200, 0, 20),\n        red(0, -500, 0, 200, 0, 20),\n        red(300, -500, 300, 200, 0, 20),\n      ],\n      loop: True,\n    ),\n  ]\n}\n\n// A red line from (x1, y1) to (x2, y2), drawn between start and end.\nfn red(x1: Int, y1: Int, x2: Int, y2: Int, start: Int, end: Int) -> Path {\n  Path(\n    Line(point(x1, y1), point(x2, y2)),\n    int_to_float(start),\n    int_to_float(end),\n    6.0,\n  )\n}\n\nfn point(x: Int, y: Int) -> Point {\n  Point(int_to_float(x), int_to_float(y))\n}\n\n@external(javascript, \"../gleam_stdlib/gleam/int.mjs\", \"to_float\")\nfn int_to_float(n: Int) -> Float\n","new_content_size":2110,"new_hash":"79ee072441817d79cdcc5146cc57948b6f82f43f782304bca3d4a012179387be","old_hash":"","operation":"create","path":"src/levels.gleam"},"hash":"cc86a3f8d5030abe8a35b9ba0cb784c745303cad157497b263f52bb1db03ca8d","kind":"fs.external_change","prev_hash":"4b60aaa7d5648ee8f9eb7366199a3ffcf95220b9e797f9722ff2ef59ed934420","seq":5121,"t":75781384,"wall":"2026-11-15T22:59:18.972Z"}
{"data":{"diff_size":84,"new_content":"//// The game's levels: where the anchor starts, and the red (\"evil\") paths the\n//// player must avoid. See game.gleam for the rules.\n////\n//// Coordinates are the canvas's: (0, 0) is the centre, x and y run from -500 to\n//// 500, and y grows downward, so the top edge is y = -500.\n\nimport gleam/int\nimport shape.{type Path, type Point, Line, Path, Point}\n\npub type Level {\n  Level(\n    name: String,\n    // Where the anchor is when the level starts or restarts.\n    start: Point,\n    // The red paths, timed on the red clock (tenths of a second).\n    red: List(Path),\n    // True: the red paths start over from an empty canvas after they finish.\n    // False: they stay once drawn.\n    loop: Bool,\n  )\n}\n\n/// The code a level starts with, before the player has edited it.\npub const starter_code = \"fn draw(shape_slider: Int) -> List(Path) {\n  [Path(Line(anchor, Point(anchor.x, anchor.y - 250)), 0, 10, 4)]\n}\n\nfn move_anchor(anchor: Point) -> Point {\n  Point(anchor.x, anchor.y - 200)\n}\n\"\n\n/// Every level, in menu order.\n/// PLACEHOLDERS: two simple levels to exercise both kinds of red drawing. The\n/// real levels are still to be designed.\npub fn all() -> List(Level) {\n  [\n    Level(\n      name: \"Level 1\",\n      start: Point(0.0, 480.0),\n      red: [\n        red(0, -500, 0, 150, 0, 40),\n        red(0, -500, -350, 100, 5, 45),\n        red(0, -500, 350, 100, 5, 45),\n        red(0, -150, -200, 50, 20, 40),\n      ],\n      loop: False,\n    ),\n    Level(\n      name: \"Level 2\",\n      start: Point(0.0, 480.0),\n      red: [\n        red(-300, -500, -300, 200, 0, 20),\n        red(0, -500, 0, 200, 0, 20),\n        red(300, -500, 300, 200, 0, 20),\n      ],\n      loop: True,\n    ),\n  ]\n}\n\n// A red line from (x1, y1) to (x2, y2), drawn between start and end.\nfn red(x1: Int, y1: Int, x2: Int, y2: Int, start: Int, end: Int) -> Path {\n  Path(\n    Line(point(x1, y1), point(x2, y2)),\n    int.to_float(start),\n    int.to_float(end),\n    6.0,\n  )\n}\n\nfn point(x: Int, y: Int) -> Point {\n  Point(int.to_float(x), int.to_float(y))\n}\n","new_content_size":2026,"new_hash":"23ebe9d836696726b6a6bdce92f84b56e1932c6b326ffa30d5d851e8a489a09d","old_hash":"79ee072441817d79cdcc5146cc57948b6f82f43f782304bca3d4a012179387be","operation":"modify","path":"src/levels.gleam"},"hash":"c8f9e2096fde85a6ee8076cf9385455c1414ba1d7d22805ef6746b5a2c574a2f","kind":"fs.external_change","prev_hash":"cc86a3f8d5030abe8a35b9ba0cb784c745303cad157497b263f52bb1db03ca8d","seq":5122,"t":75785443,"wall":"2026-11-15T22:59:23.030Z"}
