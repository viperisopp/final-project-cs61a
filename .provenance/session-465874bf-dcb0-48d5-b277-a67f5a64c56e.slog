-ai4ed.preceptor","version":"0.1.6"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":false,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":false,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.42.0"},{"enabled":false,"id":"ritwickdey.LiveServer","version":"5.7.10"},{"enabled":false,"id":"samplavigne.p5-vscode","version":"1.2.16"}]},"hash":"7a2daf2fd4729f28695c0ab05a9a2d3e6106d620741dcd542056776197313d68","kind":"ext.snapshot","prev_hash":"2e992abc0bc3787457ebfea5f09ede6463ed51bddd7a7c0916c8988ffa88d055","seq":2,"t":2,"wall":"2026-11-15T01:56:17.667Z"}
