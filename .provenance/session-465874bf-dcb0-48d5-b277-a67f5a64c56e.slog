eceptor","version":"0.1.6"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":true,"id":"ms-python.python","version":"2026.10.0"},{"enabled":true,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":true,"id":"ms-python.vscode-python-envs","version":"1.42.0"},{"enabled":true,"id":"ritwickdey.LiveServer","version":"5.7.10"},{"enabled":false,"id":"samplavigne.p5-vscode","version":"1.2.16"}]},"hash":"40825aa8ddac967267e611ef0e5dd8cb3cf1fdc56a543d9ac06511ad8e582cab","kind":"ext.snapshot","prev_hash":"df3734c09064177fbeddff8fe4695fcb0be6fc9970bfda7b6391816242032ef8","seq":4855,"t":72550300,"wall":"2026-11-15T22:05:27.999Z"}
