{"data":{"extensions":[{"enabled":true,"id":"TypeScriptTeam.jsts-chat-features","version":"0.0.6"},{"enabled":false,"id":"vscode.bat","version":"10.0.0"},{"enabled":false,"id":"vscode.clojure","version":"10.0.0"},{"enabled":false,"id":"vscode.coffeescript","version":"10.0.0"},{"enabled":true,"id":"vscode.configuration-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.cpp","version":"10.0.0"},{"enabled":false,"id":"vscode.csharp","version":"10.0.0"},{"enabled":false,"id":"vscode.css","version":"10.0.0"},{"enabled":false,"id":"vscode.css-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.dart","version":"10.0.0"},{"enabled":true,"id":"vscode.debug-auto-launch","version":"10.0.0"},{"enabled":false,"id":"vscode.debug-server-ready","version":"10.0.0"},{"enabled":false,"id":"vscode.diff","version":"10.0.0"},{"enabled":false,"id":"vscode.docker","version":"10.0.0"},{"enabled":false,"id":"vscode.dotenv","version":"10.0.0"},{"enabled":true,"id":"vscode.emmet","version":"10.0.0"},{"enabled":false,"id":"vscode.extension-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.fsharp","version":"10.0.0"},{"enabled":true,"id":"vscode.git","version":"10.0.0"},{"enabled":true,"id":"vscode.git-base","version":"10.0.0"},{"enabled":true,"id":"vscode.github","version":"0.0.1"},{"enabled":true,"id":"vscode.github-authentication","version":"0.0.2"},{"enabled":false,"id":"vscode.go","version":"10.0.0"},{"enabled":false,"id":"vscode.groovy","version":"10.0.0"},{"enabled":false,"id":"vscode.grunt","version":"10.0.0"},{"enabled":false,"id":"vscode.gulp","version":"10.0.0"},{"enabled":false,"id":"vscode.handlebars","version":"10.0.0"},{"enabled":false,"id":"vscode.hlsl","version":"10.0.0"},{"enabled":false,"id":"vscode.html","version":"10.0.0"},{"enabled":false,"id":"vscode.html-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.ini","version":"10.0.0"},{"enabled":false,"id":"vscode.ipynb","version":"10.0.0"},{"enabled":false,"id":"vscode.jake","version":"10.0.0"},{"enabled":false,"id":"vscode.java","version":"10.0.0"},{"enabled":false,"id":"vscode.javascript","version":"10.0.0"},{"enabled":false,"id":"vscode.json","version":"10.0.0"},{"enabled":true,"id":"vscode.json-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.julia","version":"10.0.0"},{"enabled":false,"id":"vscode.latex","version":"10.0.0"},{"enabled":false,"id":"vscode.less","version":"10.0.0"},{"enabled":false,"id":"vscode.log","version":"10.0.0"},{"enabled":false,"id":"vscode.lua","version":"10.0.0"},{"enabled":false,"id":"vscode.make","version":"10.0.0"},{"enabled":false,"id":"vscode.markdown","version":"30.0.0"},{"enabled":false,"id":"vscode.markdown-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.markdown-math","version":"10.0.0"},{"enabled":true,"id":"vscode.merge-conflict","version":"10.0.0"},{"enabled":false,"id":"vscode.mermaid-markdown-features","version":"10.0.0"},{"enabled":false,"id":"vscode.microsoft-authentication","version":"0.0.1"},{"enabled":false,"id":"ms-vscode.js-debug","version":"1.140.0"},{"enabled":false,"id":"ms-vscode.js-debug-companion","version":"1.1.3"},{"enabled":false,"id":"ms-vscode.vscode-js-profile-table","version":"1.0.11"},{"enabled":false,"id":"vscode.builtin-notebook-renderers","version":"10.0.0"},{"enabled":true,"id":"vscode.npm","version":"10.0.0"},{"enabled":false,"id":"vscode.objective-c","version":"10.0.0"},{"enabled":false,"id":"vscode.perl","version":"10.0.0"},{"enabled":false,"id":"vscode.php","version":"10.0.0"},{"enabled":false,"id":"vscode.php-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.powershell","version":"10.0.0"},{"enabled":false,"id":"vscode.prompt","version":"10.0.0"},{"enabled":false,"id":"vscode.pug","version":"10.0.0"},{"enabled":false,"id":"vscode.python","version":"10.0.0"},{"enabled":false,"id":"vscode.r","version":"10.0.0"},{"enabled":false,"id":"vscode.razor","version":"10.0.0"},{"enabled":false,"id":"vscode.references-