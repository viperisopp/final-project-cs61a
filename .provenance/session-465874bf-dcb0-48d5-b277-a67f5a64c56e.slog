{"data":{"active_file":"extension.txt","focused":true,"idle_since_ms":10486.548999994993},"hash":"e5a5ee7fdc09b94b5342921ed337fb4b6f73af8580a92a1d9e833721e94a76cc","kind":"session.heartbeat","prev_hash":"0ed2fe78f0e1ec673adc747c61010ce9702c7ae32da85673d51f62c7ef8aeba1","seq":5253,"t":77620674,"wall":"2026-11-15T23:29:58.208Z"}
{"data":{"diff_size":3,"new_content":"//// The game's levels: where the anchor starts, and the red (\"evil\") paths the\n//// player must avoid. See game.gleam for the rules.\n////\n//// Coordinates are the canvas's: (0, 0) is the centre, x and y run from -500 to\n//// 500, and y grows downward, so the top edge is y = -500.\n\nimport gleam/int\nimport shape.{type Path, type Point, Line, Path, Point}\n\npub type Level {\n  Level(\n    name: String,\n    // Where the anchor is when the level starts or restarts.\n    start: Point,\n    // The red paths, timed on the red clock (tenths of a second).\n    red: List(Path),\n    // True: the red paths start over from an empty canvas after they finish.\n    // False: they stay once drawn.\n    loop: Bool,\n    // The code the level starts with, before the player has edited it.\n    starter: String,\n  )\n}\n\n/// The code the numbered levels start with.\npub const starter_code =\n  \"fn draw(shape_slider: Int) -> List(Path) {\n  [Path(Line(anchor, Point(anchor.x, anchor.y - 250)), 0, 10, 4)]\n}\n\nfn move_anchor(anchor: Point) -> Point {\n  Point(anchor.x, anchor.y - 200)\n}\n\"\n\n/// The Tutorial level's code: a working climb, explained step by step.\npub const tutorial_code =\n  \"// Tutorial: climb to the green bar at the top without\n// touching a red line or the left and right edges. Press\n// Restart to watch this code win, then try the experiments\n// at the bottom.\n\n// `anchor` is the gold diamond. Every line must start there.\n// y grows downward, so going up means making y smaller.\nfn draw(shape_slider: Int) -> List(Path) {\n  // One line from the anchor, 300 units straight up, drawn\n  // between time 0 and time 10 (tenths of a second).\n  [Path(Line(anchor, Point(anchor.x, anchor.y - 300)), 0, 10, 4)]\n}\n\n// Where the anchor goes next: the small dark diamond. Once\n// your line is drawn through it, the anchor jumps there, and\n// draw runs again so your next line starts from it.\nfn move_anchor(anchor: Point) -> Point {\n  Point(anchor.x, anchor.y - 250)\n}\n\n// Experiments:\n// 1. In draw, change anchor.x to anchor.x + 300. The line\n//    misses the dark diamond, so the anchor stops moving.\n// 2. Instead, change Point(anchor.x, anchor.y - 300) to\n//    Point(300, -150). Your line now ends where the red line\n//    is heading, so you are caught when it grows across to it.\n// 3. Change the times 0, 10 to 0, 30. The climb is slower;\n//    watch the red line grow while you wait.\n// 4. Press Pause just after the anchor moves, then Reset.\n//    Your old lines vanish but the anchor stays put.\n\"\n\n/// Every level, in menu order.\n/// PLACEHOLDERS: Level 1 and Level 2 are simple levels that exercise both kinds\n/// of red drawing. The real levels are still to be designed.\npub fn all() -> List(Level) {\n  [\n    // Gentle: one slow red line that grows from the right edge toward the\n    // left, stopping short of the straight climb up the middle.\n    Level(\n      name: \"Tutorial\",\n      start: Point(0.0, 480.0),\n      red: [red(500, -150, 150, -150, 0, 80)],\n      loop: False,\n      starter: tutorial_code,\n    ),\n    Level(\n      name: \"Level 1\",\n      start: Point(0.0, 480.0),\n      red: [\n        red(0, -500, 0, 150, 0, 40),\n        red(0, -500, -350, 100, 5, 45),\n        red(0, -500, 350, 100, 5, 45),\n        red(0, -150, -200, 50, 20, 40),\n      ],\n      loop: False,\n      starter: starter_code,\n    ),\n    Level(\n      name: \"Level 2\",\n      start: Point(0.0, 480.0),\n      red: [\n        red(-300, -500, -300, 200, 0, 20),\n        red(0, -500, 0, 200, 0, 20),\n        red(300, -500, 300, 200, 0, 20),\n      ],\n      loop: True,\n      starter: starter_code,\n    ),\n  ]\n}\n\n// A red line from (x1, y1) to (x2, y2), drawn between start and end.\nfn red(x1: Int, y1: Int, x2: Int, y2: Int, start: Int, end: Int) -> Path {\n  Path(\n    Line(point(x1, y1), point(x2, y2)),\n    int.to_float(start),\n    int.to_float(end),\n    6.0,\n  )\n}\n\nfn point(x: Int, y: Int) -> Point {\n  Point(int.to_float(x), int.to_float(y))\n}\n","new_content_size":3919,"new_hash":"72412528016c27e656b95def40bcdd4d7bbe24cbe292ae802716f6748c36e023","old_hash":"d2176a45aecef8b21a5ecb4a2fb67706edbee3eb1e7671f5e99de80227889afd","operation":"modify","path":"src/levels.gleam"},"hash":"c48889359a301251d1b82271716c83938054361403d2bb27c4cf08af7a16bcbb","kind":"fs.external_change","prev_hash":"e5a5ee7fdc09b94b5342921ed337fb4b6f73af8580a92a1d9e833721e94a76cc","seq":5254,"t":77637750,"wall":"2026-11-15T23:30:15.283Z"}
{"data":{"extensions":[{"enabled":true,"id":"TypeScriptTeam.jsts-chat-features","version":"0.0.6"},{"enabled":false,"id":"vscode.bat","version":"10.0.0"},{"enabled":false,"id":"vscode.clojure","version":"10.0.0"},{"enabled":false,"id":"vscode.coffeescript","version":"10.0.0"},{"enabled":true,"id":"vscode.configuration-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.cpp","version":"10.0.0"},{"enabled":false,"id":"vscode.csharp","version":"10.0.0"},{"enabled":false,"id":"vscode.css","version":"10.0.0"},{"enabled":false,"id":"vscode.css-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.dart","version":"10.0.0"},{"enabled":true,"id":"vscode.debug-auto-launch","version":"10.0.0"},{"enabled":false,"id":"vscode.debug-server-ready","version":"10.0.0"},{"enabled":false,"id":"vscode.diff","version":"10.0.0"},{"enabled":false,"id":"vscode.docker","version":"10.0.0"},{"enabled":false,"id":"vscode.dotenv","version":"10.0.0"},{"enabled":true,"id":"vscode.emmet","version":"10.0.0"},{"enabled":true,"id":"vscode.extension-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.fsharp","version":"10.0.0"},{"enabled":true,"id":"vscode.git","version":"10.0.0"},{"enabled":true,"id":"vscode.git-base","version":"10.0.0"},{"enabled":true,"id":"vscode.github","version":"0.0.1"},{"enabled":true,"id":"vscode.github-authentication","version":"0.0.2"},{"enabled":false,"id":"vscode.go","version":"10.0.0"},{"enabled":false,"id":"vscode.groovy","version":"10.0.0"},{"enabled":false,"id":"vscode.grunt","version":"10.0.0"},{"enabled":false,"id":"vscode.gulp","version":"10.0.0"},{"enabled":false,"id":"vscode.handlebars","version":"10.0.0"},{"enabled":false,"id":"vscode.hlsl","version":"10.0.0"},{"enabled":false,"id":"vscode.html","version":"10.0.0"},{"enabled":false,"id":"vscode.html-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.ini","version":"10.0.0"},{"enabled":false,"id":"vscode.ipynb","version":"10.0.0"},{"enabled":false,"id":"vscode.jake","version":"10.0.0"},{"enabled":false,"id":"vscode.java","version":"10.0.0"},{"enabled":false,"id":"vscode.javascript","version":"10.0.0"},{"enabled":false,"id":"vscode.json","version":"10.0.0"},{"enabled":true,"id":"vscode.json-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.julia","version":"10.0.0"},{"enabled":false,"id":"vscode.latex","version":"10.0.0"},{"enabled":false,"id":"vscode.less","version":"10.0.0"},{"enabled":false,"id":"vscode.log","version":"10.0.0"},{"enabled":false,"id":"vscode.lua","version":"10.0.0"},{"enabled":false,"id":"vscode.make","version":"10.0.0"},{"enabled":false,"id":"vscode.markdown","version":"30.0.0"},{"enabled":true,"id":"vscode.markdown-language-features","version":"10.0.0"},{"enabled":true,"id":"vscode.markdown-math","version":"10.0.0"},{"enabled":true,"id":"vscode.merge-conflict","version":"10.0.0"},{"enabled":true,"id":"vscode.mermaid-markdown-features","version":"10.0.0"},{"enabled":false,"id":"vscode.microsoft-authentication","version":"0.0.1"},{"enabled":false,"id":"ms-vscode.js-debug","version":"1.140.0"},{"enabled":false,"id":"ms-vscode.js-debug-companion","version":"1.1.3"},{"enabled":false,"id":"ms-vscode.vscode-js-profile-table","version":"1.0.11"},{"enabled":false,"id":"vscode.builtin-notebook-renderers","version":"10.0.0"},{"enabled":true,"id":"vscode.npm","version":"10.0.0"},{"enabled":false,"id":"vscode.objective-c","version":"10.0.0"},{"enabled":false,"id":"vscode.perl","version":"10.0.0"},{"enabled":false,"id":"vscode.php","version":"10.0.0"},{"enabled":false,"id":"vscode.php-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.powershell","version":"10.0.0"},{"enabled":false,"id":"vscode.prompt","version":"10.0.0"},{"enabled":false,"id":"vscode.pug","version":"10.0.0"},{"enabled":false,"id":"vscode.python","version":"10.0.0"},{"enabled":false,"id":"vscode.r","version":"10.0.0"},{"enabled":false,"id":"vscode.razor","version":"10.0.0"},{"enabled":false,"id":"vscode.references-view","version":"10.0.0"},{"enabled":false,"id":"vscode.restructuredtext","version":"10.0.0"},{"enabled":false,"id":"vscode.ruby","version":"10.0.0"},{"enabled":false,"id":"vscode.rust","version":"10.0.0"},{"enabled":false,"id":"vscode.scss","version":"10.0.0"},{"enabled":false,"id":"vscode.search-result","version":"10.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"10.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"10.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"10.0.0"},{"enabled":false,"id":"vscode.sql","version":"10.0.0"},{"enabled":false,"id":"vscode.swift","version":"10.0.0"},{"enabled":true,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-modern-icons","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"10.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript","version":"10.0.0"},{"enabled":true,"id":"vscode.typescript-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.vb","version":"10.0.0"},{"enabled":false,"id":"vscode.xml","version":"10.0.0"},{"enabled":false,"id":"vscode.yaml","version":"10.0.0"},{"enabled":true,"id":"Anthropic.claude-code","version":"2.1.325"},{"enabled":true,"id":"berkeley-ai4ed.preceptor","version":"0.1.6"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":true,"id":"ms-python.python","version":"2026.10.0"},{"enabled":true,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":true,"id":"ms-python.vscode-python-envs","version":"1.42.0"},{"enabled":true,"id":"ritwickdey.LiveServer","version":"5.7.10"},{"enabled":false,"id":"samplavigne.p5-vscode","version":"1.2.16"}]},"hash":"7dfe8a29f6682f353fa16aba3dd4bf81eea8c104bed76f485643d9c8519b8fee","kind":"ext.snapshot","prev_hash":"c48889359a301251d1b82271716c83938054361403d2bb27c4cf08af7a16bcbb","seq":5255,"t":77650319,"wall":"2026-11-15T23:30:27.851Z"}
