{"data":{"content":"# Gleam build output that isn't needed to run the app.\n#\n# Keep build/dev/javascript/ itself: index.html loads the compiled app from\n# ./build/dev/javascript/animator/app.mjs, so the deployed site needs it.\nbuild/packages/\nbuild/lsp/\nbuild/*.lock\n_gleam_artefacts/\n\n# Editor and OS clutter\n.DS_Store\n*.swp\nerl_crash.dump\n\n# Downloaded course bundles\n*.zip\n","line_count":17,"path":".gitignore","sha256":"55900b7ce09aec991a6934d57b954b27d2756ccdaf77be1ea51f0b2f23e93c32"},"hash":"d3cd740c25f51ad5df0bd2ed5092bc84b9dfefb7600311289d3bb0eda26c8bcb","kind":"doc.open","prev_hash":"1fe9cbf9c2b25d0a510ad143eef2b9ed9dc8641faa50b202c5e345e76cd0de3c","seq":5442,"t":79790762,"wall":"2026-11-16T00:06:08.463Z"}
